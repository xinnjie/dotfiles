// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "which_key": {
    "enabled": true
  },
  "proxy": "",
  "title_bar": {
    "show_menus": false
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.8-flash-low",
        "mode": "yolo"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "low",
        "mode": "bypassPermissions",
        "model": "sonnet"
      },
      "type": "registry"
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "model": [
          "gpt-5.5",
          "gpt-5.4-mini"
        ]
      },
      "default_config_options": {
        "mode": "agent-full-access",
        "model": "gpt-6-luna",
        "reasoning_effort": "medium"
      },
      "type": "registry"
    }
  },
  "agent": {
    "dock": "left",
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gemini-3.1-pro-preview",
        "enable_thinking": false
      },
      {
        "provider": "zed.dev",
        "model": "gemini-3-flash",
        "enable_thinking": false
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.5",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "tool_permissions": {
      "default": "allow"
    },
    "use_modifier_to_send": true,
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.5",
    },
    "play_sound_when_agent_done": "always",
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": false,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "base_keymap": "JetBrains",
  "language_models": {
    "openai_compatible": {
      "Nvidia": {
        "api_url": "https://integrate.api.nvidia.com/v1",
        "available_models": [
          {
            "name": "z-ai/glm4.7",
            "display_name": "glm4.7",
            "max_tokens": 1000000,
          },
          {
            "name": "minimaxai/minimax-m2.1",
            "display_name": "minimax2.1",
            "max_tokens": 1000000,
          },
        ],
      },
    },
  },
  "lsp": {
    "sourcekit-lsp": {
      "binary": {
        "env": {
        }
      }
    }
  },
}
